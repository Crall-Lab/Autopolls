[Unit]
Description=pollinatorcamera discover
After=network.target

[Service]
User=pi # change to username
Group=pi # change to your username
ExecStart=home_dir/Autopolls/pcam/services/run_discover.sh
#TODO make this a timer
RestartSec=300
Restart=always
StandardOutput=file:/mnt/data/logs/discover.out
StandardError=file:/mnt/data/logs/discover.err

[Install]
WantedBy=multi-user.target
