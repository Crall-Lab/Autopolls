[Unit]
Description=uWSGI instance to serve pcam ui
After=network.target nginx.service systemd-tmpfiles-setup.service

[Service]
User=pi
Group=pi
WorkingDirectory=%h/AP/Autopolls/
ExecStart=/bin/bash -c "PATH=%h/.virtualenvs/autopolls/bin:$PATH exec %h/.virtualenvs/autopolls/bin/uwsgi --ini pcam-ui.ini"

[Install]
WantedBy=multi-user.target

