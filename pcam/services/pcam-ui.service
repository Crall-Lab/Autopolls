[Unit]
Description=uWSGI instance to serve pcam ui
After=network.target nginx.service systemd-tmpfiles-setup.service

[Service]
User=pi
Group=pi
WorkingDirectory=home_dir/Autopolls/pcam/
ExecStart=/bin/bash -c "PATH=home_dir/.virtualenvs/autopolls/bin:$PATH exec home_dir/.virtualenvs/autopolls/bin/uwsgi --ini pcam-ui.ini"

[Install]
WantedBy=multi-user.target

